#!/usr/bin/env bash
# meet-ai's MCP front door, over stdio. Nothing may be written to stdout but protocol.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ ! -x "$DIR/.venv/bin/python" ]]; then
  echo "Virtualenv missing. Run: python3 -m venv .venv && .venv/bin/pip install -r requirements.txt" >&2
  exit 1
fi

exec "$DIR/.venv/bin/python" -m meetnotes.mcp_server "$@"
